.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Local Configuration, Secrets, & Databases
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Explicitly keep example environment templates
!.env.example
!*.env.example

# ------------------------------------------------------------------------------
# Embedded Firmware & PlatformIO (controller & supervisor)
# ------------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json
*.bin
*.elf
*.hex
*.map

# ------------------------------------------------------------------------------
# Node.js & Web Assets
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~
*.bak

# VS Code workspace files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
