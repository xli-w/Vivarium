[Unit]
Description=Frog Terrarium Raspberry Pi Supervisor
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=terrarium
WorkingDirectory=/opt/frog-terrarium/pi
EnvironmentFile=/opt/frog-terrarium/pi/.env
ExecStart=/opt/frog-terrarium/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/frog-terrarium
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
